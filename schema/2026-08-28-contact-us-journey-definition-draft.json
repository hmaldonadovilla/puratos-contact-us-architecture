          "lastName": {
            "type": "string",
            "title": "contact.person.lastName",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "title": "contact.person.email",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "title": "contact.person.phone",
            "maxLength": 40
          },
          "companyName": {
            "type": "string",
            "title": "contact.company.name",
            "minLength": 1,
            "maxLength": 200
          },
          "vatNumber": {
            "type": "string",
