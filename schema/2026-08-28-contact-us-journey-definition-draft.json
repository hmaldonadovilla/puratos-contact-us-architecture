          "ui:widget": "PuratosText"
        },
        "email": {
          "ui:widget": "PuratosText"
        },
        "phone": {
          "ui:widget": "PuratosPhone"
        },
        "companyName": {
          "ui:widget": "PuratosText"
        },
        "vatNumber": {
          "ui:widget": "PuratosText"
        },
        "message": {
          "ui:widget": "PuratosTextArea"
        },
        "privacyNoticeAccepted": {
          "ui:widget": "PuratosCheckbox"
        },
        "emailMarketingConsent": {
          "ui:widget": "PuratosCheckbox"
        },
        "ui:submitButtonOptions": {
          "norender": true
        }
