          "firstName": {
            "type": "string",
            "title": "contact.person.firstName",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "title": "contact.person.lastName",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "title": "contact.person.email",
            "format": "email",
            "maxLength": 254
          },
          "companyName": {
            "type": "string",
            "title": "contact.company.name",
            "minLength": 1,
            "maxLength": 200
          },
          "vatNumber": {
            "type": "string",
            "title": "contact.company.vatNumber",
            "pattern": "^BE[0-9]{10}$"
