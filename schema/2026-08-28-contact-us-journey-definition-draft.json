    {
      "id": "authenticated_request",
      "type": "FORM",
      "serverDecision": "RESOLVE_CUSTOMER_REQUEST_TYPE",
      "serverValidators": [
        "VALIDATE_COMMERCE_REFERENCE"
      ],
      "trustedContext": {
        "displayKeys": [
          "identity.customerDisplayName",
          "identity.accountDisplayName"
        ],
        "editable": false,
        "excludedFromFormData": [
          "customerNumber",
          "contactNumber",
          "crmContactId"
        ]
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/authenticated-request/v1",
        "type": "object",
        "properties": {
          "requestCategory": {
            "type": "string",
            "title": "contact.request.category",
            "enum": [
              "GENERAL_QUESTION",
              "ORDER_OR_DELIVERY",
              "COMPLAINT"
            ]
          },
          "message": {
            "type": "string",
            "title": "contact.request.message",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "requestCategory",
          "message"
        ],
        "dependencies": {
          "requestCategory": {
            "oneOf": [
              {
                "properties": {
                  "requestCategory": {
                    "enum": [
                      "GENERAL_QUESTION",
                      "COMPLAINT"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "requestCategory": {
                    "enum": [
                      "ORDER_OR_DELIVERY"
                    ]
                  },
                  "commerceReference": {
                    "type": "object",
                    "title": "contact.request.orderReference",
                    "properties": {
                      "referenceType": {
                        "type": "string",
                        "enum": [
                          "ORDER",
                          "INVOICE",
                          "NOT_LISTED",
                          "UNKNOWN"
                        ]
                      },
                      "referenceId": {
                        "type": "string",
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "referenceType"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "commerceReference"
                ]
              }
            ]
          }
        }
      },
      "uiSchema": {
        "requestCategory": {
          "ui:widget": "PuratosRadio"
        },
        "commerceReference": {
          "ui:field": "PuratosCommerceReferenceLookup"
        },
        "message": {
          "ui:widget": "PuratosTextArea"
        },
        "ui:order": [
          "requestCategory",
          "commerceReference",
          "message"
        ],
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "operator": "VALID"
          },
          "nextNodeId": "submit_contact_request"
        }
      ]
    },
    {
      "id": "submit_contact_request",
      "type": "ACTION",
      "actionKey": "SUBMIT_CONTACT_REQUEST",
      "idempotencyRequired": true,
      "onSuccessNodeId": "request_received_terminal",
      "onBusinessReviewNodeId": "manual_review_terminal"
    },
    {
      "id": "faq_action",
      "type": "ACTION",
      "actionKey": "OPEN_FAQ",
      "terminalAfterAction": true
    },
    {
      "id": "ai_assistant_action",
      "type": "ACTION",
      "actionKey": "OPEN_AI_ASSISTANT",
      "terminalAfterAction": true
    },
