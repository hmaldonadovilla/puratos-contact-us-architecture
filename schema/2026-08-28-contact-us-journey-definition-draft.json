    {
      "id": "authenticated_options",
      "type": "FORM",
      "trustedContext": {
        "displayKeys": [
          "identity.customerDisplayName",
          "identity.accountDisplayName"
        ],
        "editable": false
      },
      "contentKeys": {
        "heading": "contact.authenticated.heading"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/authenticated-options/v1",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "title": "contact.authenticated.action",
            "oneOf": [
              {
                "const": "FAQ",
                "title": "contact.action.faq"
              },
              {
                "const": "AI_ASSISTANT",
                "title": "contact.action.aiAssistant"
              },
              {
                "const": "CALL_CUSTOMER_CARE",
                "title": "contact.action.callCustomerCare"
              },
              {
                "const": "SEND_QUESTION",
                "title": "contact.action.sendQuestion"
              }
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "uiSchema": {
        "action": {
          "ui:widget": "PuratosRadio"
        },
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "answerPath": "action",
            "operator": "EQ",
            "value": "FAQ"
          },
          "nextNodeId": "faq_action"
        },
        {
          "when": {
            "answerPath": "action",
            "operator": "EQ",
            "value": "AI_ASSISTANT"
          },
          "nextNodeId": "ai_assistant_action"
