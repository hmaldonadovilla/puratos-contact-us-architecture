{
  "documentType": "PuratosContactJourneyDefinition",
  "draftStatus": "ARCHITECTURE_DRAFT",
  "manifest": {
    "definitionId": "contact-us",
    "definitionVersion": "BE-0005-2026-08-28-01-draft",
    "configurationVersion": "BE-0005-2026-08-28-01",
    "renderingContractVersion": "1.0",
    "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#",
    "rjsfCompatibility": "5.24.x",
    "market": "BE",
    "salesOrganisation": "0005",
    "language": "en-BE",
    "rolloutState": "PILOT",
    "experienceVariant": "AEM_TARGET",
    "entryNodeId": "account_access",
    "safeFallback": "LEGACY",
    "effectiveFrom": "2026-08-28T00:00:00Z",
    "effectiveTo": null
  },
  "definitionPolicy": {
    "serverAuthoritativeProgression": true,
    "allowExecutableJavaScript": false,
    "allowArbitraryUrls": false,
    "allowUnknownWidgets": false,
    "removeAdditionalProperties": true,
    "countryFieldsResolvedBeforeDelivery": true,
    "notes": [
      "This is an illustrative Belgium-resolved definition; VAT is present because the example market requires it.",
      "Another market receives its own immutable resolved version without the VAT property when VAT is not applicable.",
      "The example entryNodeId is anonymous; OutSystems returns authenticated_options for a server-verified authenticated journey.",
      "AEM may render allowed transitions for usability, but OutSystems validates the current node and returns the authoritative next node.",
      "Customers provide an exact positive employee count. OutSystems preserves that value for C4C and derives any employee band only inside the versioned server decision."
    ]
  },
  "allowedCatalogue": {
    "widgets": [
      "PuratosCheckbox",
      "PuratosRadio",
      "PuratosSelect",
      "PuratosText",
      "PuratosNumber",
      "PuratosTextArea",
      "PuratosPhone",
      "PuratosCommerceReferenceLookup"
    ],
    "fields": [
      "PuratosCommerceReferenceLookup"
    ],
    "serverValidators": [
      "VALIDATE_CONTACT_DETAILS",
      "VALIDATE_VAT_FOR_MARKET",
      "VALIDATE_COMMERCE_REFERENCE",
      "VALIDATE_DISTRIBUTOR_APPLICATION"
    ],
    "serverDecisions": [
      "EVALUATE_SERVICE_MODEL",
      "RESOLVE_CUSTOMER_REQUEST_TYPE"
    ],
    "actions": [
      "OPEN_FAQ",
      "OPEN_AI_ASSISTANT",
      "CALL_CUSTOMER_CARE",
      "SUBMIT_CONTACT_REQUEST"
    ],
    "destinations": [
      "MYPURATOS_LOGIN",
      "MYPURATOS_EXISTING_CUSTOMER_REGISTRATION",
      "MYPURATOS_NEW_CUSTOMER_REGISTRATION",
      "WEBSHOP",
      "DISTRIBUTOR_FINDER"
    ]
  },
  "capabilities": {
    "faq": true,
    "aiAssistant": true,
    "callCustomerCare": true,
    "personalSupport": true,
    "distributorApplication": true,
    "webshopRedirect": true,
    "authenticatedOrderLookup": true,
    "vatField": true
  },
  "nodes": [
    {
      "id": "account_access",
      "type": "FORM",
      "contentKeys": {
        "heading": "contact.account.heading",
        "description": "contact.account.description"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/account-access/v1",
        "type": "object",
        "properties": {
          "hasMyPuratosAccount": {
            "type": "boolean",
            "title": "contact.account.hasAccount"
          }
        },
        "required": [
          "hasMyPuratosAccount"
        ],
        "additionalProperties": false
      },
      "uiSchema": {
        "hasMyPuratosAccount": {
          "ui:widget": "PuratosRadio"
        },
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "answerPath": "hasMyPuratosAccount",
            "operator": "EQ",
            "value": true
          },
          "nextNodeId": "login_redirect"
        },
        {
          "when": {
            "answerPath": "hasMyPuratosAccount",
            "operator": "EQ",
            "value": false
          },
          "nextNodeId": "customer_status"
        }
      ]
    },
    {
      "id": "customer_status",
      "type": "FORM",
      "contentKeys": {
        "heading": "contact.customerStatus.heading"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/customer-status/v1",
        "type": "object",
        "properties": {
          "customerStatus": {
            "type": "string",
            "title": "contact.customerStatus.question",
            "oneOf": [
              {
                "const": "EXISTING_CUSTOMER",
                "title": "contact.customerStatus.existing"
              },
              {
                "const": "NEW_TO_PURATOS",
                "title": "contact.customerStatus.new"
              }
            ]
          }
        },
        "required": [
          "customerStatus"
        ],
        "additionalProperties": false
      },
      "uiSchema": {
        "customerStatus": {
          "ui:widget": "PuratosRadio"
        },
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "answerPath": "customerStatus",
            "operator": "EQ",
            "value": "EXISTING_CUSTOMER"
          },
          "nextNodeId": "existing_customer_registration_redirect"
        },
        {
          "when": {
            "answerPath": "customerStatus",
            "operator": "EQ",
            "value": "NEW_TO_PURATOS"
          },
          "nextNodeId": "new_customer_intent"
        }
      ]
    },
    {
      "id": "new_customer_intent",
      "type": "FORM",
      "contentKeys": {
        "heading": "contact.intent.heading"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/new-customer-intent/v1",
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "title": "contact.intent.question",
            "oneOf": [
              {
                "const": "BUY_PRODUCTS",
                "title": "contact.intent.buyProducts"
              },
              {
                "const": "DISTRIBUTOR_APPLICATION",
                "title": "contact.intent.becomeDistributor"
              },
              {
                "const": "HOME_BAKER",
                "title": "contact.intent.homeBaker"
              }
            ]
          }
        },
        "required": [
          "intent"
        ],
        "additionalProperties": false
      },
      "uiSchema": {
        "intent": {
          "ui:widget": "PuratosRadio"
        },
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "answerPath": "intent",
            "operator": "EQ",
            "value": "BUY_PRODUCTS"
          },
          "nextNodeId": "buy_products_profile"
        },
        {
          "when": {
            "answerPath": "intent",
            "operator": "EQ",
            "value": "DISTRIBUTOR_APPLICATION"
          },
          "nextNodeId": "distributor_application"
        },
        {
          "when": {
            "answerPath": "intent",
            "operator": "EQ",
            "value": "HOME_BAKER"
          },
          "nextNodeId": "distributor_finder_redirect"
        }
      ]
    },
    {
      "id": "buy_products_profile",
      "type": "FORM",
      "contentKeys": {
        "heading": "contact.buyProfile.heading"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "puratos://contact-us/buy-products-profile/v1",
        "type": "object",
        "properties": {
          "businessType": {
            "type": "string",
            "title": "contact.company.businessType",
            "enum": [
              "ARTISAN",
              "INDUSTRY",
              "HORECA",
              "CHOCOLATIER",
              "BAKERY_CHAIN",
              "OTHER"
            ]
          },
          "employeeCount": {
            "type": "integer",
            "title": "contact.company.employeeCount",
            "minimum": 1
          }
        },
        "required": [
          "businessType",
          "employeeCount"
        ],
        "dependencies": {
          "businessType": {
            "oneOf": [
              {
                "properties": {
                  "businessType": {
                    "enum": [
                      "BAKERY_CHAIN"
                    ]
                  },
                  "storeCountBand": {
                    "type": "string",
                    "title": "contact.company.storeCountBand",
                    "enum": [
                      "ONE",
                      "TWO_TO_FIVE",
                      "SIX_TO_TWENTY",
                      "MORE_THAN_TWENTY"
                    ]
                  }
                },
                "required": [
                  "storeCountBand"
                ]
              },
              {
                "properties": {
                  "businessType": {
                    "enum": [
                      "ARTISAN",
                      "INDUSTRY",
                      "HORECA",
                      "CHOCOLATIER",
                      "OTHER"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "uiSchema": {
        "businessType": {
          "ui:widget": "PuratosSelect"
        },
        "employeeCount": {
          "ui:widget": "PuratosNumber",
          "ui:help": "Enter the exact current number. Puratos uses it for CRM context and derives routing bands internally."
        },
        "storeCountBand": {
          "ui:widget": "PuratosSelect"
        },
        "ui:order": [
          "businessType",
          "employeeCount",
          "storeCountBand"
        ],
        "ui:submitButtonOptions": {
          "norender": true
        }
      },
      "transitions": [
        {
          "when": {
            "operator": "VALID"
          },
          "nextNodeId": "service_model_decision"
        }
      ]
    },
    {
      "id": "service_model_decision",
      "type": "SERVER_DECISION",
      "decisionKey": "EVALUATE_SERVICE_MODEL",
      "inputBindings": {
        "employeeCount": "buy_products_profile.employeeCount",
        "businessType": "buy_products_profile.businessType"
      },
      "ruleSetKey": "SERVICE_MODEL_BY_EMPLOYEE_COUNT",
      "ruleSetVersion": "BE-0005-2026-08-28-01",
      "allowedOutcomes": {
        "SELF_SERVICE_ONLY": "new_customer_registration_redirect",
        "SELF_SERVICE_OR_PERSONAL": "service_model_choice",
        "PERSONAL_ASSISTANCE": "personal_support_request",
        "MANUAL_REVIEW": "manual_review_terminal"
      }
    },
    {
      "id": "service_model_choice",
      "type": "FORM",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
