            "pattern": "^BE[0-9]{10}$"
          },
          "message": {
            "type": "string",
            "title": "contact.request.message",
            "minLength": 1,
            "maxLength": 4000
          },
          "privacyNoticeAccepted": {
            "type": "boolean",
